          "marking": { "correct": 4, "incorrect": 0 },
          "question": "The de Broglie wavelength of an electron accelerated through a potential difference of $100\\text{ V}$ is $\\lambda = \\frac{x}{\\sqrt{V}}\\text{ nm}$, where $x = 1.227$. What is the value of $\\lambda$ in $\\text{nm}$ (rounded to 3 decimals)?",
          "correctValue": 0.123,
          "solution": "$\\lambda = \\frac{1.227}{\\sqrt{100}} = 0.1227 \\approx 0.123\\text{ nm}$."
        }
